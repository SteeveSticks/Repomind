# Copy this file to .env.local for the Next.js app.
# Never put real secrets in git. Vercel and Trigger.dev get their own copies.

# Neon pooled URL for Next.js. Locally this is the Docker Compose URL.
# Example local value: postgresql://repomind:repomind@127.0.0.1:5432/repomind
DATABASE_URL=

# Neon direct URL (not the pooler) for the Python worker.
# Locally this may match DATABASE_URL.
DATABASE_URL_DIRECT=

# Shared secret for POST /api/ingest (header x-ingest-secret).
# Locally you may pick a well known dev value. Vercel needs a real secret.
INGEST_SECRET=

# Voyage embeddings (laptop, worker, and Vercel)
VOYAGE_API_KEY=

# Groq chat on Vercel. Optional on your laptop (Ollama is the fallback).
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Local chat. Used when GROQ_API_KEY is unset.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5-coder:7b

# Optional. Helps with GitHub archive rate limits.
GITHUB_TOKEN=

# Trigger.dev project key. DEV key for local .env.local, production key on
# Vercel and in the Trigger.dev dashboard. Required for production ingest.
TRIGGER_SECRET_KEY=
